#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --time=06:00:00
#SBATCH -e s2e_%j.err
#SBATCH -J s2e_diag
#SBATCH -o s2e_%j.out
#SBATCH -p sequana_cpu

# S-2E: 2nd-edgewise frequency vs mesh refinement (1.0 / 0.5 / 0.25 m)
set -euo pipefail

module purge
module load glu gcc/14.2.0_sequana
export VENV_DIR=$SCRATCH/venv
export PATH=${VENV_DIR}/bin/:$PATH
GCC14_LIB=$(gcc -print-file-name=libstdc++.so.6 | xargs dirname)
export LD_LIBRARY_PATH=${GCC14_LIB}:${VENV_DIR}/lib/:${VENV_DIR}/lib64/:/usr/lib64/psm2-compat:/scratch/app/openmpi/4.1.4_gnu/lib

cd /scratch/leahk/eduardo.donestevez/fem-shell
python3 tools/run_s2e_diagnostic.py --sizes 1.0 0.5 0.25 2>&1 | tail -20
echo "S-2E DONE"
