#!/bin/bash
#SBATCH --ntasks=8
#SBATCH --time=06:00:00
#SBATCH -e runs/slurm/step1b_%j.err
#SBATCH -J step1b_smoke_fsi
#SBATCH -o runs/slurm/step1b_%j.out
#SBATCH -p sequana_cpu

# Step 1b: smoke FSI 30 s yaw=0 with the rotorspin fix — the decisive test:
# the flexible thrust must land BELOW the rigid anchor (2.541 MN, shear 0).
set -euo pipefail

module purge
module load glu gcc/14.2.0_sequana
export VENV_DIR=$SCRATCH/venv
export PATH=${VENV_DIR}/bin/:$PATH
GCC14_LIB=$(gcc -print-file-name=libstdc++.so.6 | xargs dirname)
export LD_LIBRARY_PATH=${GCC14_LIB}:${VENV_DIR}/lib/:${VENV_DIR}/lib64/:/usr/lib64/psm2-compat:/scratch/app/openmpi/4.1.4_gnu/lib

# Submit from the root of the checkout to run (main tree or a worktree):
#   mkdir -p runs/slurm && RUN_NAME=<name> sbatch tests/run_step1b_smoke.srm
# SOLID_YAML=<file in smoke_fix/base_fix/> swaps the solid case (default: the base case).
# FLUID_YAML=<file in smoke_fix/base_fix/> swaps the fluid case (default: the base case).
# Results land in <checkout>/runs/smoke_fix/<RUN_NAME>/ (git-ignored), and the
# package is imported from that checkout's src/, not from the editable install.
REPO=${SLURM_SUBMIT_DIR:-$(pwd)}
[[ -f ${REPO}/tests/run_step1b_smoke.srm ]] || { echo "submit from the repo root"; exit 2; }
export PYTHONPATH=${REPO}/src${PYTHONPATH:+:${PYTHONPATH}}
SUBMIT_DIR=${REPO}/tests
CASES_DIR=${SUBMIT_DIR}/smoke_fix
RESULTS_BASE=${RESULTS_BASE:-${REPO}/runs/smoke_fix}
RUN_NAME=${RUN_NAME:-base_fix}
SOLID_YAML=${SOLID_YAML:-solid_corotational_yaw_0.yaml}
FLUID_YAML=${FLUID_YAML:-fluid_yaw_0.yaml}
CASE_DIR=${RESULTS_BASE}/${RUN_NAME}
export CASE_DIR
rm -rf ${CASE_DIR}
mkdir -p ${CASE_DIR}/logs
( cd ${CASE_DIR} && ${SUBMIT_DIR}/IEA15MW/_run_solid.sh ${CASES_DIR}/base_fix/${SOLID_YAML} ) \
    >> ${CASE_DIR}/logs/solid.log 2>&1 &
SOLID_PID=$!
sleep 2
( cd ${CASE_DIR} && ${SUBMIT_DIR}/IEA15MW/_run_fluid.sh ${CASES_DIR}/base_fix/${FLUID_YAML} ${CASE_DIR} ) \
    >> ${CASE_DIR}/logs/fluid.log 2>&1 &
FLUID_PID=$!

FAILED=0
wait ${SOLID_PID} || { echo "[FAIL] solid exit=$?"; FAILED=1; }
wait ${FLUID_PID} || { echo "[FAIL] fluid exit=$?"; FAILED=1; }
[[ ${FAILED} -eq 0 ]] && echo "STEP1b SMOKE OK" || echo "STEP1b SMOKE FAILED"

python3 - <<'PY'
import numpy as np, csv
import os
p = os.path.join(os.environ['CASE_DIR'], 'fluid', 'bem_report.csv')
t = []; th = []; d = []
with open(p) as f:
    rdr = csv.DictReader(f)
    for row in rdr:
        t.append(float(row['Time [s]'])); th.append(float(row['Thrust [N]']))
        d.append(float(row['Tip Disp Mag [m]']))
t = np.array(t); th = np.array(th); d = np.array(d)
m = (t >= 15) & (t <= 30)
print(f'SMOKE thrust steady: {th[m].mean()/1e6:.3f} MN  (rigid anchor 2.541)')
print(f'SMOKE tip steady:    {d[m].mean():.2f} m')
print(f'SMOKE thrust p2p:    {(th[m].max()-th[m].min())/1e3:.1f} kN')
PY

echo "STEP1b DONE"
