#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --time=08:00:00
#SBATCH -e s8_%j.err
#SBATCH -J s8_paper_tests
#SBATCH -o s8_%j.out
#SBATCH -p sequana_cpu

# S-8a (Camarena circumferential GJ) + S-8b (Almeida semi-chord bend-twist)
set -euo pipefail

module purge
module load glu gcc/14.2.0_sequana
export VENV_DIR=$SCRATCH/venv
export PATH=${VENV_DIR}/bin/:$PATH
GCC14_LIB=$(gcc -print-file-name=libstdc++.so.6 | xargs dirname)
export LD_LIBRARY_PATH=${GCC14_LIB}:${VENV_DIR}/lib/:${VENV_DIR}/lib64/:/usr/lib64/psm2-compat:/scratch/app/openmpi/4.1.4_gnu/lib

cd /scratch/leahk/eduardo.donestevez/fem-shell
echo "=== S-8a: GJ circumferential refinement ==="
python3 tools/run_s8a_gj_circumferential.py 2>&1 | tail -8
echo "=== S-8b: semi-chord tip loads ==="
python3 tools/run_s8b_semichord.py 2>&1 | tail -8
echo "S-8 DONE"
