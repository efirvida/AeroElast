#!/bin/bash
#SBATCH -p sequana_cpu_dev
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:20:00
#SBATCH -J ccxParityCost
#SBATCH -e ccxParityCost-%j.err
#SBATCH -o ccxParityCost-%j.out
#
# Cost measurement for the parked V50 aeroelast-vs-CCX parity campaign.
# Measures two things so the full campaign can be projected:
#   1. CCX-only cost per dynamic increment at the production mesh (0.25 m, S8R).
#   2. The real coupled run (BEM fluid participant + ccx_preCICE), which gives
#      seconds per coupling window and iterations per window.
# A measurement, not a verdict run: both parts are bounded by a deadline-aware
# budget and whatever completes is enough.
# ---------------------------------------------------------------------------

set -u

REPO=/scratch/leahk/eduardo.donestevez/fem-shell
VENV=/scratch/leahk/eduardo.donestevez/venv
GCC=/scratch/app_sequana/gcc/14.2.0

export PATH="$VENV/bin:$PATH"
export LD_LIBRARY_PATH="$GCC/lib64:$VENV/lib:$VENV/lib64:/usr/lib64/psm2-compat:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"

# Rayleigh coefficients measured on the 2.0 m gate mesh (zeta 0.03, modes 1-2).
# Fixed here so generation does not pay for the 290k-DOF modal solve.
ALPHA=0.11420634811691575
BETA=0.007712724310186446

RUN=/scratch/leahk/eduardo.donestevez/parked_v50_ccx/cost_$SLURM_JOB_ID
mkdir -p "$RUN"
cd "$RUN" || exit 1

START_EPOCH=$(date +%s)
DEADLINE=$((START_EPOCH + 19 * 60)) # 19 min inside the 20 min partition limit

log() { echo "[$(date +%H:%M:%S)] $*"; }
remaining() { echo $((DEADLINE - $(date +%s))); }
budget() { # budget <cap> <floor>
	local value=$(($(remaining) - $1))
	[ "$value" -gt "$2" ] && value=$2
	[ "$value" -lt "$3" ] && value=$3
	echo "$value"
}

log "host=$(hostname) cpus=$SLURM_CPUS_PER_TASK OMP=$OMP_NUM_THREADS run=$RUN"
lscpu | grep -E "^Model name|^CPU\(s\)" | head -2

# ---------------------------------------------------------------------------
# 1. Production-size deck
# ---------------------------------------------------------------------------
log "=== generating the 0.25 m deck (no modal solve)"
GEN_START=$(date +%s)
timeout "$(budget 900 600 60)" python "$REPO/tools/ccx_fsi_parity_parked_v50.py" \
	--out-dir "$RUN" \
	--element-size 0.25 \
	--dt 1e-2 \
	--t-end 60.0 \
	--alpha "$ALPHA" --beta "$BETA" \
	--abs-paths >generate.json 2>&1
GEN_RC=$?
log "generation rc=$GEN_RC elapsed=$(( $(date +%s) - GEN_START ))s"
grep -E '"mesh_nodes"|"mesh_elements"|"rayleigh_eta' generate.json | head -4
if [ "$GEN_RC" -ne 0 ]; then
	tail -20 generate.json
	exit 1
fi
grep -m1 '^\*STEP' solid_ccx.inp
grep -m1 -A3 '^\*CLOAD' solid_ccx.inp

# ---------------------------------------------------------------------------
# 2. CCX-only increment cost
# ---------------------------------------------------------------------------
# The coupled deck carries *zero* interface loads by adapter requirement, which
# would make every increment trivial.  The timing copy gets a realistic load and
# a 3-increment window so the Newton/factorisation work per increment is
# comparable.  The node set is upper-case in the deck: NALLOUTERSHELLNODS.
CCX_BUDGET=$(budget 540 420 90)
log "=== CCX-only increment cost (3 increments, 1 kN/node flapwise load, budget ${CCX_BUDGET}s)"
mkdir -p ccxonly
cp solid_ccx.inp solid_ccx.msh solid_ccx.nam ccxonly/
sed -i 's/^NALLOUTERSHELLNODS, 2, 0.0/NALLOUTERSHELLNODS, 2, 1.0E+03/' ccxonly/solid_ccx.inp
sed -i 's/^1\.000000E-02, 6\.000000E+01/1.000000E-02, 3.000000E-02/' ccxonly/solid_ccx.inp
grep -m1 ', 2, ' ccxonly/solid_ccx.inp
grep -m1 '^1\.000000E-02,' ccxonly/solid_ccx.inp
CCX_START=$(date +%s)
(
	cd ccxonly || exit 1
	/usr/bin/time -v timeout "$CCX_BUDGET" ccx solid_ccx >ccx_only.log 2>ccx_only.time
	echo "ccx rc=$?"
)
CCX_WALL=$(( $(date +%s) - CCX_START ))
CCX_INCR=$(grep -c -i "increment" ccxonly/ccx_only.log)
log "ccx-only: ${CCX_WALL}s wall, ${CCX_INCR} increment log lines"
grep -E "Total CalculiX Time" ccxonly/ccx_only.log
grep -E "Maximum resident set size|Elapsed \(wall clock\)|Percent of CPU" ccxonly/ccx_only.time
if [ "$CCX_INCR" -gt 0 ]; then
	awk -v w="$CCX_WALL" -v n="$CCX_INCR" 'BEGIN { printf "  ~%.1f s per increment (lower bound)\n", w / 3 }'
fi

# ---------------------------------------------------------------------------
# 3. Real coupled run (bounded)
# ---------------------------------------------------------------------------
COUPLED_LIMIT=$(budget 45 780 60)
log "=== coupled run (budget ${COUPLED_LIMIT}s): solid acceptor first, then the BEM fluid"
COUPLED_START=$(date +%s)
timeout "$COUPLED_LIMIT" ccx_preCICE -i solid_ccx -precice-participant Solid \
	>solid_coupled.log 2>&1 &
SOLID_PID=$!
sleep 5
timeout "$COUPLED_LIMIT" fem-shell-bem-fsi fluid_v50_parity.yaml \
	>fluid_coupled.log 2>&1 &
FLUID_PID=$!
wait "$SOLID_PID"
SOLID_RC=$?
wait "$FLUID_PID"
FLUID_RC=$?
COUPLED_WALL=$(( $(date +%s) - COUPLED_START ))
log "coupled finished in ${COUPLED_WALL}s (solid rc=$SOLID_RC fluid rc=$FLUID_RC)"

# ---------------------------------------------------------------------------
# 4. Summary
# ---------------------------------------------------------------------------
WINDOWS=$(wc -l <precice-Solid-iterations.log 2>/dev/null || echo 0)
log "=== preCICE windows completed: $WINDOWS in ${COUPLED_WALL}s"
if [ "$WINDOWS" -gt 0 ]; then
	awk -v elapsed="$COUPLED_WALL" '
		{ it = $NF; sum += it; if (it > max) max = it; n++ }
		END {
			printf "  iterations/window: mean=%.2f max=%d\n", sum / n, max
			printf "  seconds/window: %.3f\n", elapsed / n
			printf "  projection 15 s run (1500 windows, dt=1e-2): %.1f h\n", elapsed / n * 1500 / 3600
			printf "  projection 60 s run (6000 windows, dt=1e-2): %.1f h\n", elapsed / n * 6000 / 3600
		}' precice-Solid-iterations.log
fi
echo "--- preCICE iterations log (head/tail):"
head -3 precice-Solid-iterations.log 2>/dev/null
tail -3 precice-Solid-iterations.log 2>/dev/null
echo "--- solid log tail:"
tail -15 solid_coupled.log 2>/dev/null
echo "--- fluid log tail:"
tail -15 fluid_coupled.log 2>/dev/null

log "=== accounting"
sacct -j "$SLURM_JOB_ID" --format=JobID,Elapsed,MaxRSS,MaxVMSize,AveCPU,State 2>/dev/null | head -5
log "total wall $(( $(date +%s) - START_EPOCH ))s of $(( DEADLINE - START_EPOCH ))s budget"
log "done"
