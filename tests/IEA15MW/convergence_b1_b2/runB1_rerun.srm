#!/bin/bash
#SBATCH -p sequana_cpu
#SBATCH --ntasks=48
#SBATCH -J b1b2_b1_rerun
#SBATCH --time=24:00:00
#SBATCH -e logs/slurm_%j.err
#SBATCH -o logs/slurm_%j.out
#SBATCH --mail-type=END,FAIL

# ── B1+B2 re-run — clean h/dt convergence ─────────────────────────────────────
# Re-runs h_coarse and h_fine with the FLUID mesh pinned at element_size=0.25
# (identical BEM stations across h levels). The May-23 B1 runs co-varied the
# fluid mesh with the solid mesh, shifting the BEM station radii (r0 0.468/
# 0.554/0.585) and confounding the h-convergence (non-monotonic flap_mean,
# negative Richardson order).
#
# Also re-runs dt_coarse/dt_fine: the original B2 results were lost when the
# confounded campaign directory was removed, and raw bem_report.csv files are
# needed to regenerate the convergence figure.
#
# Baseline (h=0.25 solid / 0.25 fluid, dt=0.01) is NOT re-run: reuse
# $SCRATCH/frontiersin_results_corotational_100s/yaw_0/.
#
# Cases:
#   h_coarse   solid element_size=0.5,   fluid 0.25, dt=0.01
#   h_fine     solid element_size=0.125, fluid 0.25, dt=0.01
#   dt_coarse  solid/fluid 0.25, dt=0.02
#   dt_fine    solid/fluid 0.25, dt=0.005
#
# Reduced disk footprint (group quota was the failure cause on 2026-09-08):
#   solid write_interval=0.5 s (was 0.05) + save_deformed_mesh=false in all
#   four YAMLs. The B1/B2 metrics come from fluid/bem_report.csv only; the
#   solid VTUs/HDF5 are not needed for postprocessing. state.npz checkpoints
#   are kept (restart capability, ≤0.5 s lost on crash).
#
# Results land in $SCRATCH/convergence_b1_b2_results_b1fix/<case>/.
# Expected walltime: h_coarse ~1.4 h, dt_coarse ~2.8 h, dt_fine ~11 h,
# h_fine ~22 h (bottleneck).
#
# Postprocess after completion:
#   RESULTS_BASE=$SCRATCH/convergence_b1_b2_results_b1fix \
#   BASELINE_PATH=$SCRATCH/frontiersin_results_corotational_100s/yaw_0 \
#   python docs/validation_plots/plot_convergence_b1_b2.py
#
# Usage:
#   cd tests/IEA15MW/convergence_b1_b2
#   sbatch runB1_rerun.srm

set -uo pipefail

CASES=(h_coarse h_fine dt_coarse dt_fine)

SUBMIT_DIR="$SLURM_SUBMIT_DIR"
RESULTS_BASE="${RESULTS_BASE:-${SCRATCH}/convergence_b1_b2_results_official}"

RUN_SOLID="${SUBMIT_DIR}/../_run_solid.sh"
RUN_FLUID="${SUBMIT_DIR}/../_run_fluid.sh"

ALL_PIDS=()
ALL_NAMES=()

echo "Job:          ${SLURM_JOB_ID:-N/A}"
echo "Nodes:        ${SLURM_NODELIST:-N/A}"
echo "Submit dir:   $SUBMIT_DIR"
echo "Cases:        ${CASES[*]}"
echo "Results:      ${RESULTS_BASE}/<case>/"
echo ""

# ── Preflight ────────────────────────────────────────────────────────────────
for f in "$RUN_SOLID" "$RUN_FLUID"; do
    [[ -x "$f" ]] || { echo "PREFLIGHT ERROR: not found or not executable: $f" >&2; exit 1; }
done

for case in "${CASES[@]}"; do
    for f in \
        "${SUBMIT_DIR}/solid_${case}.yaml" \
        "${SUBMIT_DIR}/fluid_${case}.yaml"; do
        [[ -f "$f" ]] || { echo "PREFLIGHT ERROR: missing YAML: $f" >&2; exit 1; }
    done
done
echo "Preflight OK — all YAMLs present."

mkdir -p "${RESULTS_BASE}/logs"

# ── run_case(tag) ────────────────────────────────────────────────────────────
run_case() {
    local tag=$1
    local case_dir="${RESULTS_BASE}/${tag}"
    local log_dir="${case_dir}/logs"
    local solid_yaml="${SUBMIT_DIR}/solid_${tag}.yaml"
    local fluid_yaml="${SUBMIT_DIR}/fluid_${tag}.yaml"

    mkdir -p "${case_dir}" "${log_dir}"

    echo "[${tag}] starting solid..."
    (cd "${case_dir}" && "${RUN_SOLID}" "${solid_yaml}") \
        >> "${log_dir}/solid.log" 2>&1 &
    local solid_pid=$!
    ALL_PIDS+=("$solid_pid")
    ALL_NAMES+=("${tag}/solid")
    echo "[${tag}] solid PID=${solid_pid}"

    sleep 2

    echo "[${tag}] starting fluid..."
    (cd "${case_dir}" && "${RUN_FLUID}" "${fluid_yaml}" "${case_dir}") \
        >> "${log_dir}/fluid.log" 2>&1 &
    local fluid_pid=$!
    ALL_PIDS+=("$fluid_pid")
    ALL_NAMES+=("${tag}/fluid")
    echo "[${tag}] fluid PID=${fluid_pid}"
}

# ── Launch all cases ─────────────────────────────────────────────────────────
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  B1+B2 clean h/dt convergence re-run (fluid pinned @0.25)"
echo "  yaw=0°, V=10.59 m/s, Ω=7.55 RPM, pitch=0°, 30 s simulated"
echo "════════════════════════════════════════════════════════════════"
echo ""

for case in "${CASES[@]}"; do
    run_case "$case" || { echo "ERROR: failed to launch ${case}" >&2; exit 1; }
    sleep 1
done

echo ""
echo "All ${#CASES[@]} cases launched (${#ALL_PIDS[@]} processes)."
echo "Waiting for completion..."
echo ""

# ── Wait and collect exit codes ──────────────────────────────────────────────
FAILED=0
for i in "${!ALL_PIDS[@]}"; do
    pid=${ALL_PIDS[$i]}
    name=${ALL_NAMES[$i]}
    if wait "$pid"; then
        echo "[DONE]  ${name}  (PID=${pid})"
    else
        rc=$?
        echo "[FAIL]  ${name}  (PID=${pid})  exit=${rc}" >&2
        FAILED=$((FAILED + 1))
    fi
done

echo ""
if [[ $FAILED -eq 0 ]]; then
    echo "✔  All B1 re-run cases completed successfully."
else
    echo "✖  ${FAILED} process(es) failed. Check logs in ${RESULTS_BASE}/<case>/logs/"
fi

echo ""
echo "Results layout:"
for case in "${CASES[@]}"; do
    echo "  ${case}/  corotational/  fluid/  logs/"
done
echo ""
echo "End: $(date)"
exit $FAILED
