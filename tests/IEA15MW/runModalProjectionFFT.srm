#!/bin/bash
#SBATCH -p sequana_cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH -J modal_fft_proj
#SBATCH --time=08:00:00
#SBATCH -e slurm_modal_fft_%j.err
#SBATCH -o slurm_modal_fft_%j.out
#SBATCH --mail-type=END,FAIL

# Modal projection FFT over the corotational Frontiers campaign.
#
# This job runs the *fixed-basis* modal-projection analysis implemented in
# docs/validation_plots/compute_modal_projection_fft.py.
# It does not solve a new eigenproblem at every checkpoint; instead it builds
# one reduced modal basis from the exact corotational structural model and then
# projects checkpointed u_red(t) onto that basis before computing FFTs.
#
# Usage:
#   cd tests/IEA15MW
#   sbatch runModalProjectionFFT.srm
#   BASIS_MODE=kg_static sbatch runModalProjectionFFT.srm
#   NUM_MODES=8 TIME_WINDOW="40 100" sbatch runModalProjectionFFT.srm
#   YAWS="0 20 40" CHECKPOINT_STRIDE=2 sbatch runModalProjectionFFT.srm

set -euo pipefail

SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

module purge
module load glu gcc/14.2.0_sequana

export OMPI_MCA_pml=ob1
export OMPI_MCA_btl=self,vader,tcp
export OMPI_MCA_btl_openib_allow_ib=0
ulimit -n 65535 >/dev/null 2>&1 || true

export VENV_DIR="${VENV_DIR:-$SCRATCH/venv}"
export PATH="${VENV_DIR}/bin/:$PATH"

GCC14_LIB=$(gcc -print-file-name=libstdc++.so.6 | xargs dirname)
export LD_LIBRARY_PATH="${GCC14_LIB}:${VENV_DIR}/lib/:${VENV_DIR}/lib64/:/usr/lib64/psm2-compat:/scratch/app/openmpi/4.1.4_gnu/lib"
export PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-}:${VENV_DIR}/lib/pkgconfig:${VENV_DIR}/lib64/pkgconfig"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export MPLBACKEND=Agg

RESULTS_ROOT="${RESULTS_ROOT:-/scratch/leahk/eduardo.donestevez/frontiersin_results_corotational_100s}"
CONFIG_PATH="${CONFIG_PATH:-${REPO_ROOT}/tests/IEA15MW/frontiersin_2025_yaw/solid_corotational_yaw_0.yaml}"
BASIS_MODE="${BASIS_MODE:-unloaded}"
NUM_MODES="${NUM_MODES:-6}"
PLOT_MODES="${PLOT_MODES:-4}"
CHECKPOINT_STRIDE="${CHECKPOINT_STRIDE:-1}"
TIME_WINDOW="${TIME_WINDOW:-40 100}"
YAWS="${YAWS:-0 10 20 30 40}"
MAX_CHECKPOINTS="${MAX_CHECKPOINTS:-}"
MAX_FREQ="${MAX_FREQ:-2.5}"
read -r START_TIME END_TIME <<< "${TIME_WINDOW}"
read -ra YAW_ARRAY <<< "${YAWS}"

CMD=(
    "${VENV_DIR}/bin/python3"
    "${REPO_ROOT}/docs/validation_plots/compute_modal_projection_fft.py"
    --results-root "${RESULTS_ROOT}"
    --config "${CONFIG_PATH}"
    --basis-mode "${BASIS_MODE}"
    --num-modes "${NUM_MODES}"
    --plot-modes "${PLOT_MODES}"
    --checkpoint-stride "${CHECKPOINT_STRIDE}"
    --start-time "${START_TIME}"
    --end-time "${END_TIME}"
    --max-freq "${MAX_FREQ}"
    --yaws
)

for yaw in "${YAW_ARRAY[@]}"; do
    CMD+=("${yaw}")
done

if [[ -n "${MAX_CHECKPOINTS}" ]]; then
    CMD+=(--max-checkpoints "${MAX_CHECKPOINTS}")
fi

echo "Job:           ${SLURM_JOB_ID}"
echo "Node(s):       ${SLURM_NODELIST}"
echo "Repo root:     ${REPO_ROOT}"
echo "Results root:  ${RESULTS_ROOT}"
echo "Config path:   ${CONFIG_PATH}"
echo "Basis mode:    ${BASIS_MODE}"
echo "Num modes:     ${NUM_MODES}"
echo "Yaws:          ${YAWS}"
echo "Window [s]:    ${START_TIME} ${END_TIME}"
echo "Stride:        ${CHECKPOINT_STRIDE}"
echo "Max samples:   ${MAX_CHECKPOINTS:-all}"
echo "Start:         $(date)"
echo ""
printf 'Command: '
printf '%q ' "${CMD[@]}"
printf '\n\n'

cd "${REPO_ROOT}"
"${CMD[@]}"

echo ""
echo "End: $(date)"