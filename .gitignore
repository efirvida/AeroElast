target/

# ---------------------------------------------------------------------------
# OpenFOAM: salidas generadas por las simulaciones.
#
# IMPORTANTE: los patrones estan anclados a los arboles de casos
# (examples/ y simulations/). NO usar patrones globales del estilo
# **/*.csv, **/*.png, **/*.vtk o **/[0-9]*/: capturan contenido legitimo
# del repo (docs/, tests/, src/) y git lo ignora en silencio.
# ---------------------------------------------------------------------------

# Directorios de tiempo y variantes del directorio 0
examples/**/[0-9]*
examples/**/0.*/
simulations/**/[0-9]*
simulations/**/0.*/

# Mallas y datos regenerables
examples/**/constant/polyMesh/*
simulations/**/constant/polyMesh/*

# Procesamiento paralelo
examples/**/processor*/
examples/**/*.host
simulations/**/processor*/
simulations/**/*.host

# Post-procesamiento y logs
examples/**/postProcessing/**
examples/**/postProcess/**
examples/**/log.*
examples/**/*.log
simulations/**/postProcessing/**
simulations/**/postProcess/**
simulations/**/log.*
simulations/**/*.log

# Salidas de solver, volcados de nucleo y datos post-procesados
examples/**/*.foam
examples/**/*.ensight
examples/**/*.png
examples/**/*.csv
examples/**/*.dat
examples/**/*.vtk
examples/**/core
examples/**/core.[0-9]*
simulations/**/*.foam
simulations/**/*.ensight
simulations/**/*.png
simulations/**/*.csv
simulations/**/*.dat
simulations/**/*.vtk
simulations/**/core
simulations/**/core.[0-9]*

# Excepciones: las plantillas 0.orig/ SI se versionan.
# Deben ir despues de todos los patrones positivos que las alcancen.
!examples/**/0.orig/
!simulations/**/0.orig/

# Logs de build en la raiz del repo.
# Anclado a la raiz (/*.log) a proposito: no debe afectar docs/ ni tests/.
/*.log

# HPC job logs, scratch and local artifacts (never repo material)
*.out
*.err
_TMP_/
.Trash-1000/
output/
logs/
bin/
solid_mesh.vtu
*.vtu
tools/wine-*.AppImage
tests/blades/
tests/hub.stl

# CodeGraph local index
.codegraph/

# Local Pi runtime state
.atl/
